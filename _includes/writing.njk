---
layout: base.njk
---

<article class="writing-page">

  <a href="{{ '/#writing' | url }}" class="back-link">all writing</a>

  <h2 class="writing-page-title">{{ title }}</h2>
  <div class="writing-page-meta">
    {{ date | year }}{% if type %} · {{ type }}{% endif %}
  </div>

  <div class="writing-page-body">
    {{ content | safe }}
  </div>

</article>
