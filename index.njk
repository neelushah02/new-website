<section id="writing">
  <h1>Writing</h1>
  <ul class="writing-list">
    {% for item in collections.writing %}
    <li>
      <div class="writing-meta">
        {{ item.date | year }}{% if item.data.type %} &middot; {{ item.data.type }}{% endif %}
      </div>
      <div class="writing-title">
        {% if item.data.link %}
          <a href="{{ item.data.link }}" target="_blank" rel="noopener">{{ item.data.title }}</a>
        {% else %}
          <a href="{{ item.url }}">{{ item.data.title }}</a>
        {% endif %}
      </div>
      {% if item.data.description %}
        <p class="writing-desc">{{ item.data.description }}</p>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>


