<script>
  // Easter egg: clicking "Herman Melville" reveals a quote
  const trigger = document.getElementById('melville-trigger');
  const quote   = document.getElementById('melville-quote');
  let shown = false;

  trigger.addEventListener('click', function(e) {
    e.preventDefault();
    if (!shown) {
      quote.classList.add('visible');
      setTimeout(() => quote.classList.add('shown'), 20);
      shown = true;
    } else {
      quote.classList.remove('shown');
      setTimeout(() => quote.classList.remove('visible'), 500);
      shown = false;
    }
  });

  // Magnetic drift on writing list items
  document.querySelectorAll('.writing-list li').forEach(item => {
    item.addEventListener('mousemove', function(e) {
      const rect = this.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const relX = (x / rect.width - 0.5) * 6;
      this.style.transform = `translateX(${relX}px)`;
    });
    item.addEventListener('mouseleave', function() {
      this.style.transform = 'translateX(0)';
      this.style.transition = 'transform 0.4s ease';
    });
    item.addEventListener('mouseenter', function() {
      this.style.transition = 'transform 0.1s ease';
    });
  });
</script>
